rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Catch-all default deny
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidReport(data) {
      return data.keys().hasAll([
        'namaSiswa', 'tanggal', 'jenjang', 'mataPelajaran',
        'materi', 'perkembangan', 'namaPengajar',
        'skorPemahaman', 'skorKeaktifan', 'skorFokus', 'createdAt'
      ]) &&
      data.namaSiswa is string && data.namaSiswa.size() > 0 && data.namaSiswa.size() <= 100 &&
      data.tanggal is string && data.tanggal.size() <= 30 &&
      data.jenjang is string &&
      data.mataPelajaran is string && data.mataPelajaran.size() <= 100 &&
      data.materi is string && data.materi.size() <= 10000 &&
      data.perkembangan is string && data.perkembangan.size() <= 10000 &&
      data.namaPengajar is string && data.namaPengajar.size() <= 100 &&
      (data.skorPemahaman is number || data.skorPemahaman is int) &&
      (data.skorKeaktifan is number || data.skorKeaktifan is int) &&
      (data.skorFokus is number || data.skorFokus is int);
    }

    function isValidStudent(data) {
      return data.keys().hasAll(['namaSiswa', 'jenjang', 'status', 'createdAt']) &&
      data.namaSiswa is string && data.namaSiswa.size() > 0 && data.namaSiswa.size() <= 100 &&
      data.jenjang is string &&
      data.status is string &&
      data.createdAt is string;
    }

    function isValidPhoto(data) {
      return data.keys().hasAll(['url', 'namaSiswa', 'createdAt']) &&
      data.url is string &&
      data.namaSiswa is string &&
      data.createdAt is string;
    }

    function isValidBilling(data) {
      return data.keys().hasAll(['namaSiswa', 'bulanTahun', 'jenjang', 'tarifPerSesi', 'jumlahHadir', 'totalBiaya', 'statusPembayaran', 'createdAt']) &&
      data.namaSiswa is string && data.namaSiswa.size() > 0 &&
      data.bulanTahun is string &&
      data.jenjang is string &&
      (data.tarifPerSesi is number || data.tarifPerSesi is int) &&
      (data.jumlahHadir is number || data.jumlahHadir is int) &&
      (data.totalBiaya is number || data.totalBiaya is int) &&
      data.statusPembayaran is string &&
      data.createdAt is string;
    }

    function isValidCertificate(data) {
      return data.keys().hasAll(['namaSiswa', 'mataPelajaran', 'certificateNumber', 'createdAt']) &&
      data.namaSiswa is string && data.namaSiswa.size() > 0 &&
      data.mataPelajaran is string &&
      data.certificateNumber is string &&
      data.createdAt is string;
    }

    match /reports/{reportId} {
      allow read: if true;
      allow create, update: if isValidReport(request.resource.data);
      allow delete: if true;
    }

    match /students/{studentId} {
      allow read: if true;
      allow create, update: if isValidStudent(request.resource.data);
      allow delete: if true;
    }

    match /photos/{photoId} {
      allow read: if true;
      allow create, update: if isValidPhoto(request.resource.data);
      allow delete: if true;
    }

    match /billings/{billingId} {
      allow read: if true;
      allow create, update: if isValidBilling(request.resource.data);
      allow delete: if true;
    }

    match /certificates/{certificateId} {
      allow read: if true;
      allow create, update: if isValidCertificate(request.resource.data);
      allow delete: if true;
    }
  }
}
