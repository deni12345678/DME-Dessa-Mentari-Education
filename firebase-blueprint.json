{
  "entities": {
    "Report": {
      "title": "Laporan Pembelajaran Les Privat",
      "description": "Laporan perkembangan belajar siswa per sesi les privat",
      "type": "object",
      "properties": {
        "namaSiswa": {
          "type": "string",
          "maxLength": 100,
          "description": "Nama lengkap siswa"
        },
        "tanggal": {
          "type": "string",
          "description": "Tanggal pelaksanaan les (YYYY-MM-DD)"
        },
        "jenjang": {
          "type": "string",
          "enum": ["PAUD/TK", "SD", "SMP", "SMA", "Umum"],
          "description": "Jenjang pendidikan siswa"
        },
        "mataPelajaran": {
          "type": "string",
          "maxLength": 100,
          "description": "Mata pelajaran les"
        },
        "materi": {
          "type": "string",
          "maxLength": 2000,
          "description": "Materi yang dipelajari hari ini"
        },
        "perkembangan": {
          "type": "string",
          "maxLength": 2000,
          "description": "Catatan evaluasi perkembangan dan keaktifan siswa"
        },
        "tugasRumah": {
          "type": "string",
          "maxLength": 1000,
          "description": "Tugas rumah atau PR"
        },
        "catatanOrtu": {
          "type": "string",
          "maxLength": 1000,
          "description": "Pesan khusus untuk orang tua"
        },
        "namaPengajar": {
          "type": "string",
          "maxLength": 100,
          "description": "Nama pengajar / tentor"
        },
        "skorPemahaman": {
          "type": "number",
          "description": "Skor pemahaman siswa 0-100"
        },
        "skorKeaktifan": {
          "type": "number",
          "description": "Skor keaktifan siswa 0-100"
        },
        "skorFokus": {
          "type": "number",
          "description": "Skor fokus siswa 0-100"
        },
        "tema": {
          "type": "string",
          "enum": ["solar", "emerald", "navy", "pastel", "dark"],
          "description": "Tema tampilan kartu laporan"
        },
        "createdAt": {
          "type": "string",
          "description": "Waktu pembuatan laporan"
        }
      },
      "required": [
        "namaSiswa",
        "tanggal",
        "jenjang",
        "mataPelajaran",
        "materi",
        "perkembangan",
        "namaPengajar",
        "skorPemahaman",
        "skorKeaktifan",
        "skorFokus",
        "createdAt"
      ]
    },
    "Student": {
      "title": "Siswa Terdaftar Les Privat",
      "description": "Data profil siswa terdaftar di Dessa Mentari Education",
      "type": "object",
      "properties": {
        "namaSiswa": {
          "type": "string",
          "maxLength": 100,
          "description": "Nama lengkap siswa"
        },
        "panggilan": {
          "type": "string",
          "maxLength": 50,
          "description": "Nama panggilan siswa"
        },
        "jenjang": {
          "type": "string",
          "description": "Jenjang pendidikan (TK, SD, SMP, SMA, Umum)"
        },
        "kelasGrade": {
          "type": "string",
          "maxLength": 50,
          "description": "Kelas atau grade siswa"
        },
        "sekolah": {
          "type": "string",
          "maxLength": 100,
          "description": "Nama sekolah asal siswa"
        },
        "namaOrangTua": {
          "type": "string",
          "maxLength": 100,
          "description": "Nama orang tua / wali siswa"
        },
        "nomorOrangTua": {
          "type": "string",
          "maxLength": 50,
          "description": "Nomor WA / telepon orang tua"
        },
        "alamat": {
          "type": "string",
          "maxLength": 250,
          "description": "Alamat rumah lokasi les"
        },
        "mataPelajaran": {
          "type": "string",
          "maxLength": 150,
          "description": "Mata pelajaran yang diambil"
        },
        "hariLes": {
          "type": "string",
          "maxLength": 100,
          "description": "Jadwal hari les"
        },
        "jamLes": {
          "type": "string",
          "maxLength": 50,
          "description": "Waktu/jam les"
        },
        "namaPengajar": {
          "type": "string",
          "maxLength": 100,
          "description": "Nama pengajar / tentor penanggung jawab"
        },
        "status": {
          "type": "string",
          "enum": ["Aktif", "Cuti", "Alumni"],
          "description": "Status keaktifan siswa"
        },
        "catatanKhusus": {
          "type": "string",
          "maxLength": 1000,
          "description": "Catatan khusus minat & gaya belajar siswa"
        },
        "createdAt": {
          "type": "string",
          "description": "Waktu pendaftaran siswa"
        }
      },
      "required": ["namaSiswa", "jenjang", "status", "createdAt"]
    }
  },
  "firestore": {
    "/reports/{reportId}": {
      "schema": {
        "$ref": "#/entities/Report"
      },
      "description": "Koleksi seluruh laporan pembelajaran yang dapat diakses oleh Admin dan Pengajar"
    },
    "/students/{studentId}": {
      "schema": {
        "$ref": "#/entities/Student"
      },
      "description": "Koleksi data siswa terdaftar les privat"
    }
  }
}
